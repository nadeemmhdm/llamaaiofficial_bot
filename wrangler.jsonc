{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llamaaiofficial-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "USER_STATE",
      "id": "017563e62cec42eb8cd314131d33b917"
    }
  ],
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "OLLAMA_API_KEY",
      "TELEGRAM_WEBHOOK_SECRET"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
