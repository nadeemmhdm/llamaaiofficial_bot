{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llamaaiofficial-bot",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llamaaiofficial_bot",
      "database_id": "b73e7119-b312-4d7f-997c-2251b4136620"
    }
  ],
  "triggers": { "crons": ["30 18 * * *"] },
  "secrets": {
    "required": ["TELEGRAM_BOT_TOKEN", "OLLAMA_API_KEY", "TELEGRAM_WEBHOOK_SECRET", "ADMIN_CHAT_ID"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
